# .env.example — Copy this to .env and fill in your values.
# .env is gitignored. Never commit real credentials.
#
# These values are for documentation purposes.
# For this project (no build step), edit js/config.js directly
# with your PUBLIC Supabase anon key only.
#
# NEVER place the service-role key in any frontend file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here

# Authorized emails are configured in config/authorized-emails.js
# The Edge Function reads AUTHORIZED_EMAILS from a Supabase dashboard secret.
# Set it in: Supabase Dashboard → Edge Functions → Secrets
AUTHORIZED_EMAILS=team1@example.com,team2@example.com
